# ─────────────────────────────────────────────────────────────────────
# Force Structuree : ce qui ne doit JAMAIS partir sur un depot distant
# ─────────────────────────────────────────────────────────────────────

# Secrets. Le fichier .env contient la cle de session, la chaine de
# connexion a la base et l'adresse de l'administrateur.
apps/web/.env
apps/queue/.env
deploiement-force-structuree/.env

# Le produit lui-meme. Le PDF de 200 pages et les deux classeurs Excel
# sont ce que le client achete : les publier reviendrait a les donner.
public/telechargements/
**/public/telechargements/
apps/web/public/telechargements/

# Sauvegardes de la base : elles contiennent les comptes clients.
*.archive
sauvegardes/
