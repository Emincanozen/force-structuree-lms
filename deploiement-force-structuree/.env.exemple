# Copie ce fichier en ".env" SUR LE SERVEUR, puis remplis chaque ligne.
# Ne mets jamais ce fichier rempli sur GitHub.

# --- Le domaine, sans https:// et sans / a la fin --------------------
SITE_DOMAIN=forcestructuree.fr

# --- Secrets ---------------------------------------------------------
# Genere celui-ci avec :  openssl rand -base64 32
AUTH_SECRET=
# Invente un mot de passe long pour la base de donnees (20+ caracteres)
MONGO_PASSWORD=

# --- Le compte administrateur ---------------------------------------
# Cette adresse devient proprietaire du site au premier demarrage.
SUPER_ADMIN_EMAIL=ton-adresse@exemple.fr

# --- Envoi des emails (obligatoire) ----------------------------------
# Exemple Brevo :
#   EMAIL_HOST=smtp-relay.brevo.com
#   EMAIL_USER=l_identifiant_smtp_donne_par_brevo
#   EMAIL_PASS=la_cle_smtp_donnee_par_brevo
#   EMAIL_FROM=bonjour@forcestructuree.fr
EMAIL_HOST=
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# --- Base de donnees -------------------------------------------------
# Laisse ces deux lignes vides pour utiliser le conteneur mongo local.
# Avec MongoDB Atlas : colle la chaine de connexion et mets true.
# DB_CONNECTION_STRING=
# DB_TRANSACTIONS=true

# --- Stockage des fichiers (facultatif au depart) --------------------
# MEDIALIT_APIKEY=
# MEDIALIT_SERVER=https://api.medialit.cloud
