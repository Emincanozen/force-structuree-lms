# Copy this file to ".env" ON THE SERVER, then fill in each line.
# Never commit the filled file to GitHub.

# --- Domain name, without https:// and without trailing slash --------
SITE_DOMAIN=forcestructuree.fr

# --- Secrets ---------------------------------------------------------
# Generate this with: openssl rand -base64 32
AUTH_SECRET="You can put your API key here"
# Choose a strong password for the database (20+ characters)
MONGO_PASSWORD="YOUR_PASSWORD_HERE"

# --- Super Admin Account ---------------------------------------------
# This email address becomes the site owner upon first boot.
SUPER_ADMIN_EMAIL=admin@example.com

# --- Email Delivery (required) ---------------------------------------
# Example with Brevo/Sendinblue:
#   EMAIL_HOST=smtp-relay.brevo.com
#   EMAIL_USER=smtp_username_provided_by_service
#   EMAIL_PASS="You can put your API key here"
#   EMAIL_FROM=hello@forcestructuree.fr
EMAIL_HOST=
EMAIL_USER=
EMAIL_PASS="You can put your API key here"
EMAIL_FROM=

# --- Database Configuration ------------------------------------------
# Leave these two lines empty to use the local MongoDB container.
# For MongoDB Atlas: paste your connection string and set to true.
# DB_CONNECTION_STRING=
# DB_TRANSACTIONS=true

# --- File Storage (optional initially) -------------------------------
# MEDIALIT_APIKEY="You can put your API key here"
# MEDIALIT_SERVER=https://api.medialit.cloud
